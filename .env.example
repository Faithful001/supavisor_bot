# Telegram
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal chat ID (message @userinfobot or @RawDataBot to find yours)
# or a group/channel ID (prefix with -100 for supergroups)
TELEGRAM_CHAT_ID=your_chat_id_here

# Polling
# How often to scan markets (minutes)
POLL_INTERVAL_MINUTES=5

# Market Filters
# Min 24h volume in USD — filters out illiquid markets
MIN_VOLUME_USD=25000

# Max number of markets to scan per cycle
MARKETS_LIMIT=50

# ---- Signal Thresholds ----
# Wide spread: flag if (ask - bid) / ask > this value (0.05 = 5%)
SPREAD_THRESHOLD=0.05

# Price drift: flag if price changed > this % since last poll (0.08 = 8%)
DRIFT_THRESHOLD=0.08

# Complement mismatch: flag if YES + NO deviate from $1 by more than this (cents)
COMPLEMENT_THRESHOLD=0.03
